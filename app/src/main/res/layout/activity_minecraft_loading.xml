<?xml version="1.0" encoding="utf-8"?>
<!-- CRAVO-native runtime loading screen; no Levi visual resources. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0B0E"
    android:paddingHorizontal="28dp"
    android:paddingVertical="22dp"
    tools:context=".core.minecraft.MinecraftLoadingActivity">

    <ImageView
        android:id="@+id/minecraftLaunchLogo"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:src="@drawable/cravo_icon_foreground"
        android:contentDescription="@string/splash_logo_desc"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/minecraftLaunchTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:includeFontPadding="false"
        android:text="@string/cravo_launch_brand"
        android:textColor="#F7F2F5"
        android:textSize="27sp"
        android:letterSpacing="0.16"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/minecraftLaunchSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/minecraftLaunchLogo"
        app:layout_constraintTop_toTopOf="@id/minecraftLaunchLogo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/minecraftLaunchSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:text="@string/cravo_launch_subtitle"
        android:textColor="#B3A5B0"
        android:textSize="12sp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="@id/minecraftLaunchLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/minecraftLaunchLogo"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchTitle" />

    <TextView
        android:id="@+id/minecraftLaunchStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:includeFontPadding="false"
        android:text="@string/minecraft_loading_status_preparing"
        android:textColor="#F7F2F5"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchLogo" />

    <ProgressBar
        android:id="@+id/minecraftLaunchProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="13dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_loading_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchStatus" />

    <TextView
        android:id="@+id/minecraftLaunchDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:minHeight="19dp"
        android:textColor="#B3A5B0"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchProgress"
        tools:text="libc++_shared.so" />

    <TextView
        android:id="@+id/minecraftLaunchLogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cravo_launch_log_title"
        android:textColor="#F7F2F5"
        android:textSize="12sp"
        android:letterSpacing="0.11"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchDetail" />

    <ScrollView
        android:id="@+id/minecraftLaunchLogScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_minecraft_loading_terminal"
        android:fadeScrollbars="false"
        android:padding="16dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/minecraftLaunchReturn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/minecraftLaunchLogTitle">

        <TextView
            android:id="@+id/minecraftLaunchLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:textColor="#E2DBE4"
            android:textSize="11sp" />
    </ScrollView>

    <Button
        android:id="@+id/minecraftLaunchCopy"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:minWidth="125dp"
        android:paddingHorizontal="12dp"
        android:text="@string/cravo_launch_copy"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/minecraftLaunchReturn"
        tools:visibility="visible" />

    <Button
        android:id="@+id/minecraftLaunchReturn"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:minWidth="145dp"
        android:paddingHorizontal="14dp"
        android:text="@string/minecraft_loading_return"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
